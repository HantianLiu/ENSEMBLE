{
  "$defs": {
    "CitationIssue": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "enum": [
            "INSERT",
            "REMOVE"
          ],
          "title": "Operation",
          "type": "string"
        },
        "target_text": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Target Text",
          "type": "string"
        },
        "citation_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Text"
        },
        "source_packet_id": {
          "anyOf": [
            {
              "pattern": "^RP-[A-Z0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Packet Id"
        },
        "rationale": {
          "maxLength": 900,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "target_text",
        "rationale"
      ],
      "title": "CitationIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "issues": {
      "items": {
        "$ref": "#/$defs/CitationIssue"
      },
      "maxItems": 20,
      "title": "Issues",
      "type": "array"
    },
    "structure_issues": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Structure Issues",
      "type": "array"
    }
  },
  "title": "CitationReview",
  "type": "object"
}
