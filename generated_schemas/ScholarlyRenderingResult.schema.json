{
  "$defs": {
    "MeetingPhase": {
      "enum": [
        "INIT",
        "INITIAL_DRAFT",
        "RESEARCH_ROUND",
        "RESEARCH_PLANNING",
        "RESEARCH_OUTLINE_REVIEW",
        "LITERATURE_MODULE_RESEARCH",
        "LITERATURE_MODULE_DRAFTING",
        "LITERATURE_MODULE_REVIEW",
        "LITERATURE_MODULE_CONFIRMATION",
        "LITERATURE_REPORT_SYNTHESIS",
        "LITERATURE_REPORT_REVIEW",
        "LITERATURE_REPORT_PUBLICATION",
        "SCHOLARLY_RENDERING_PLAN",
        "SCHOLARLY_RENDERING_DRAFT",
        "SCHOLARLY_SCIENCE_REVIEW",
        "SCHOLARLY_CITATION_REVIEW",
        "SCHOLARLY_RENDERING_PUBLICATION",
        "GENERAL_POSITION",
        "AMENDMENT_SUBMISSION",
        "COSPONSORSHIP",
        "BALLOT",
        "GENERAL_RATIFICATION",
        "STATUS_TRANSITION",
        "DETAILED_DRAFTING",
        "CLAUSE_REVIEW",
        "RESOLUTION_FROZEN",
        "CHAIR_REVIEW",
        "THINK_TANK_REVIEW",
        "HUMAN_REVIEW",
        "HANDOFF_READY",
        "PAUSED",
        "CLOSED"
      ],
      "title": "MeetingPhase",
      "type": "string"
    }
  },
  "properties": {
    "meeting_id": {
      "title": "Meeting Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "PAUSED",
        "HANDOFF_READY"
      ],
      "title": "Status",
      "type": "string"
    },
    "section_count": {
      "title": "Section Count",
      "type": "integer"
    },
    "completed_section_count": {
      "title": "Completed Section Count",
      "type": "integer"
    },
    "source_markdown_path": {
      "title": "Source Markdown Path",
      "type": "string"
    },
    "final_markdown_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Markdown Path"
    },
    "final_html_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Html Path"
    },
    "final_latex_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Latex Path"
    },
    "final_pdf_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Pdf Path"
    },
    "appendix_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Appendix Path"
    },
    "next_phase": {
      "$ref": "#/$defs/MeetingPhase"
    },
    "paused_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paused Reason"
    }
  },
  "required": [
    "meeting_id",
    "status",
    "section_count",
    "completed_section_count",
    "source_markdown_path",
    "next_phase"
  ],
  "title": "ScholarlyRenderingResult",
  "type": "object"
}
