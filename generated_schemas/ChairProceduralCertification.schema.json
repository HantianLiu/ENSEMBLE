{
  "$defs": {
    "ProceduralCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ],
          "title": "Status",
          "type": "string"
        },
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "name",
        "status",
        "explanation",
        "evidence_refs"
      ],
      "title": "ProceduralCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "CERTIFIED",
        "CORRECTION_REQUIRED",
        "HUMAN_REQUIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "resolution_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolution Sha256",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ProceduralCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "corrections": {
      "items": {
        "type": "string"
      },
      "title": "Corrections",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "status",
    "resolution_sha256",
    "checks",
    "summary"
  ],
  "title": "ChairProceduralCertification",
  "type": "object"
}
